{
  "name": "madbench",
  "version": "0.12.6",
  "description": "Toolkit for madbench, MadAppGang's Go harness for benchmarking agentic coding tools. Carries madbench's own skills with /madbench:madbench as the entry point, checks them against the installed madbench, and runs benches in a visible pane through the madbench:bench agent.",
  "author": {
    "name": "MadAppGang",
    "email": "i@madappgang.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/MadAppGang/magus",
  "tags": [
    "madbench",
    "evals",
    "benchmarking",
    "agent-testing",
    "assertions",
    "llm-judge",
    "go"
  ],
  "dependencies": [
    {
      "name": "terminal",
      "version": "^5.0"
    }
  ],
  "skills": "./skills/",
  "conventions": {
    "claudemd": {
      "section": "madbench",
      "template": "./templates/claude-md-conventions.md",
      "version": "1.2.0"
    }
  },
  "compatibility": {
    "claudeCode": ">=0.1.0"
  },
  "requires": {
    "schema": 2,
    "bin": [
      {
        "name": "bun",
        "check": [
          "bun",
          "--version"
        ],
        "install": [
          {
            "via": "bootstrap",
            "tool": "bun"
          }
        ]
      },
      {
        "name": "madbench",
        "check": [
          "madbench",
          "version"
        ],
        "install": [
          {
            "via": "brew",
            "os": [
              "darwin"
            ],
            "cask": "madappgang/tap/madbench"
          },
          {
            "via": "release",
            "repo": "MadAppGang/madbench-releases",
            "tag": "v0.57.2",
            "asset": "madbench_{os}_{arch}.tar.gz",
            "binary": "madbench",
            "sha256": {
              "darwin_amd64": "b2c0ec8fa626d9c29d75d2eae1ad66b3e837988073585f75f10f5e30cf1189e0",
              "darwin_arm64": "4eba5d8c717330e8dd0190231271937eb637b47e2d65002a4be2b5b5806de03a",
              "linux_amd64": "2c7c94d81baff7a77e2161591b6de3d31c2881808fed3f1dc16c7071bf3b2bff",
              "linux_arm64": "5cfa34f4b029800f4956fcc94e9db155271a5dedbba70ea0069f763afbe10d7a"
            }
          }
        ]
      },
      {
        "name": "magmux",
        "check": [
          "magmux",
          "--version"
        ],
        "install": [
          {
            "via": "brew",
            "os": [
              "darwin"
            ],
            "cask": "madappgang/tap/magmux"
          },
          {
            "via": "release",
            "repo": "MadAppGang/magmux",
            "tag": "v0.14.0",
            "asset": "magmux_{os}_{arch}.tar.gz",
            "binary": "magmux",
            "sha256": {
              "darwin_amd64": "3ad723b3b2ea8ab55aff1df0a91d7cdb4eef2afc121e22fbdf76b31de1d49ded",
              "darwin_arm64": "a00ebd3f0c2b9fab14b1bd1ca554aaa1f60bbdddbae4e6dd634d65fb5ffda9e3",
              "linux_amd64": "4a37911687f781e312239f86f82e259c1937f69a249897d6ee386737be4b01d7",
              "linux_arm64": "bb22ce371d136cde07a407965898ff9f6c1a46d93b19d05bd7f0cc511b9603b2"
            }
          }
        ]
      }
    ]
  }
}
