{
  "name": "terminal",
  "version": "5.6.1",
  "description": "Slot-addressed terminal control over tmux or herdr. Runs interactive commands, dev servers, test watchers, REPLs and TUI apps in numbered helper panes — beside the user or isolated from view — that the server places and owns, so an agent never holds a pane id or targets the user's own session.",
  "author": {
    "name": "Jack Rudenko",
    "email": "i@madappgang.com",
    "company": "MadAppGang"
  },
  "license": "MIT",
  "keywords": [
    "terminal",
    "pty",
    "tui",
    "interactive",
    "tmux",
    "run",
    "watch",
    "repl",
    "dev-server",
    "test-watcher",
    "slots",
    "isolated"
  ],
  "category": "development",
  "skills": [
    "./skills/terminal-interaction",
    "./skills/tui-navigation-patterns",
    "./skills/framework-signals",
    "./skills/tdd-workflow",
    "./skills/workspace-setup"
  ],
  "mcpServers": "./.mcp.json",
  "requires": {
    "schema": 2,
    "bin": [
      {
        "name": "bun",
        "check": [
          "bun",
          "--version"
        ],
        "install": [
          {
            "via": "bootstrap",
            "tool": "bun"
          }
        ]
      },
      {
        "name": "tmux",
        "check": [
          "tmux",
          "-V"
        ],
        "install": [
          {
            "via": "brew",
            "os": [
              "darwin"
            ],
            "formula": "tmux"
          },
          {
            "via": "apt",
            "os": [
              "linux"
            ],
            "packages": [
              "tmux"
            ]
          }
        ]
      },
      {
        "name": "zsh",
        "check": [
          "zsh",
          "--version"
        ],
        "install": [
          {
            "via": "brew",
            "os": [
              "darwin"
            ],
            "formula": "zsh"
          },
          {
            "via": "apt",
            "os": [
              "linux"
            ],
            "packages": [
              "zsh"
            ]
          }
        ]
      },
      {
        "name": "tmux-mcp",
        "check": [
          "tmux-mcp",
          "--version"
        ],
        "install": [
          {
            "via": "release",
            "repo": "MadAppGang/tmux-mcp",
            "tag": "v2.2.0",
            "asset": "tmux-mcp_{os}_{arch}.tar.gz",
            "binary": "tmux-mcp",
            "sha256": {
              "darwin_amd64": "c4738d01339c05f6663b6df70140b0ebd5508a0fa672bea559113f8ae485aca7",
              "darwin_arm64": "9461c0afb09a77f773162b33b316f95372e5b1692bbc7fa741e22d81d12da8fb",
              "linux_amd64": "bf1fdd12c969b47ee94357b00cb80a7a7e3564698f4d4c58fb85aea954c5cb3f",
              "linux_arm64": "92c56c076bd7f32d9ea963b3d3122e435efa772cbed043c68ee933fe79ec1c71"
            }
          }
        ]
      }
    ]
  }
}
