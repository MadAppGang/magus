{
  "name": "terminal",
  "version": "5.6.0",
  "description": "Slot-addressed terminal control over tmux or herdr. Runs interactive commands, dev servers, test watchers, REPLs and TUI apps in numbered helper panes — beside the user or isolated from view — that the server places and owns, so an agent never holds a pane id or targets the user's own session.",
  "author": {
    "name": "Jack Rudenko",
    "email": "i@madappgang.com",
    "company": "MadAppGang"
  },
  "license": "MIT",
  "keywords": [
    "terminal",
    "pty",
    "tui",
    "interactive",
    "tmux",
    "run",
    "watch",
    "repl",
    "dev-server",
    "test-watcher",
    "slots",
    "isolated"
  ],
  "category": "development",
  "skills": [
    "./skills/terminal-interaction",
    "./skills/tui-navigation-patterns",
    "./skills/framework-signals",
    "./skills/tdd-workflow",
    "./skills/workspace-setup"
  ],
  "mcpServers": "./.mcp.json",
  "requires": {
    "schema": 2,
    "bin": [
      {
        "name": "bun",
        "check": [
          "bun",
          "--version"
        ],
        "install": [
          {
            "via": "bootstrap",
            "tool": "bun"
          }
        ]
      },
      {
        "name": "tmux",
        "check": [
          "tmux",
          "-V"
        ],
        "install": [
          {
            "via": "brew",
            "os": [
              "darwin"
            ],
            "formula": "tmux"
          },
          {
            "via": "apt",
            "os": [
              "linux"
            ],
            "packages": [
              "tmux"
            ]
          }
        ]
      },
      {
        "name": "zsh",
        "check": [
          "zsh",
          "--version"
        ],
        "install": [
          {
            "via": "brew",
            "os": [
              "darwin"
            ],
            "formula": "zsh"
          },
          {
            "via": "apt",
            "os": [
              "linux"
            ],
            "packages": [
              "zsh"
            ]
          }
        ]
      },
      {
        "name": "tmux-mcp",
        "check": [
          "tmux-mcp",
          "--version"
        ],
        "install": [
          {
            "via": "release",
            "repo": "MadAppGang/tmux-mcp",
            "tag": "v2.1.1",
            "asset": "tmux-mcp_{os}_{arch}.tar.gz",
            "binary": "tmux-mcp",
            "sha256": {
              "darwin_amd64": "5f15213dba6d2938aa2b0dd06136afe1724be828e63651943711de952a2a6619",
              "darwin_arm64": "76a72df79cbade4b29fac6ca3b673b289c7966b418c8b17ed8c94f9970c433f9",
              "linux_amd64": "bf8952d5835288f9496fa191d94cb9ff035d8b61d37ea09017286d48805dabef",
              "linux_arm64": "fba7cd094e74cc2bd4004bf5ae0e570c86f05438fa3c22a06d531ec4571049aa"
            }
          }
        ]
      }
    ]
  }
}
