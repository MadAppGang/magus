{
  "name": "terminal",
  "version": "4.2.0",
  "description": "Intent-level terminal control over tmux. Runs interactive commands, dev servers, test watchers, REPLs and TUI apps in a helper pane that the server places and owns, so an agent never targets the user's own session.",
  "author": {
    "name": "Jack Rudenko",
    "email": "i@madappgang.com",
    "company": "MadAppGang"
  },
  "license": "MIT",
  "keywords": [
    "terminal",
    "pty",
    "tui",
    "interactive",
    "tmux",
    "headless",
    "run",
    "watch",
    "repl",
    "dev-server",
    "test-watcher"
  ],
  "category": "development",
  "skills": [
    "./skills/terminal-interaction",
    "./skills/tui-navigation-patterns",
    "./skills/framework-signals",
    "./skills/tdd-workflow",
    "./skills/workspace-setup"
  ],
  "setup": {
    "go": [
      "github.com/MadAppGang/tmux-mcp@v1.7.1"
    ],
    "required": [
      "tmux"
    ]
  },
  "mcpServers": "./.mcp.json"
}
