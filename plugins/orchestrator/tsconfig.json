{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["bun-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "scripts/**/*.ts",
    "hooks/guard.ts",
    "hooks/session-record.ts",
    "hooks/status/domain.ts",
    "hooks/status/model.ts",
    "hooks/status/layout.ts",
    "hooks/status/mux.ts"
  ]
}
