{
  "name": "orchestrator",
  "version": "0.4.0",
  "description": "Runs ticket work as three levels of Claude Code sessions: triage owns tickets and the plan, a manager per ticket works in its own tmux window or herdr tab and worktree, children in panes beside it. A status band lists them; a guard keeps ticket changes with triage. Needs bun, git, tmux or herdr.",
  "author": {
    "name": "MadAppGang",
    "email": "i@madappgang.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/MadAppGang/magus",
  "keywords": [
    "orchestration",
    "tickets",
    "triage",
    "tmux",
    "worktree",
    "parallel-sessions"
  ],
  "category": "development",
  "dependencies": [
    {
      "name": "dev",
      "version": "^9.6"
    },
    {
      "name": "terminal",
      "version": "^5.6.1"
    }
  ],
  "skills": [
    "./skills/triage",
    "./skills/manager",
    "./skills/child"
  ],
  "compatibility": {
    "claudeCode": ">=0.1.0"
  },
  "types": "./types/index.d.ts",
  "requires": {
    "schema": 2,
    "bin": [
      {
        "name": "bun",
        "check": [
          "bun",
          "--version"
        ],
        "install": [
          {
            "via": "bootstrap",
            "tool": "bun"
          }
        ]
      }
    ]
  }
}
