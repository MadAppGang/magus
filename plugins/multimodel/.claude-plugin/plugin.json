{
  "name": "multimodel",
  "version": "6.1.0",
  "description": "Multi-model collaboration and orchestration. Runs one task across several AI models under a task type (judge, research, plan, debug, brainstorm, implement, test, collaborate), each with its own result, or delegates it to one model running a full Claude Code session.",
  "author": {
    "name": "MadAppGang",
    "email": "i@madappgang.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/MadAppGang/magus",
  "tags": [
    "multimodel",
    "voting",
    "parallel",
    "consensus",
    "claudish",
    "grok",
    "gemini",
    "gpt",
    "minimax",
    "glm",
    "collaboration",
    "orchestration",
    "multi-agent",
    "workflow",
    "hooks",
    "routing",
    "cost-optimization"
  ],
  "dependencies": [
    {
      "name": "claudish",
      "version": "^2.0"
    }
  ],
  "skills": "./skills/",
  "compatibility": {
    "claudeCode": ">=0.1.0"
  },
  "requires": {
    "schema": 2,
    "bin": [
      {
        "name": "bun",
        "check": [
          "bun",
          "--version"
        ],
        "install": [
          {
            "via": "bootstrap",
            "tool": "bun"
          }
        ]
      },
      {
        "name": "jq",
        "check": [
          "jq",
          "--version"
        ],
        "install": [
          {
            "via": "brew",
            "os": [
              "darwin"
            ],
            "formula": "jq"
          },
          {
            "via": "apt",
            "os": [
              "linux"
            ],
            "packages": [
              "jq"
            ]
          }
        ]
      }
    ]
  }
}
