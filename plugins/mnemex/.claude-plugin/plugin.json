{
  "name": "mnemex",
  "version": "1.1.1",
  "description": "MCP runtime for semantic code search and AST analysis, ranking symbols by PageRank. Optional engine behind the code-search facade, and usable directly for its full tool surface.",
  "author": {
    "name": "Jack Rudenko",
    "email": "i@madappgang.com",
    "company": "MadAppGang"
  },
  "license": "MIT",
  "keywords": [
    "mnemex",
    "mcp",
    "semantic-search",
    "ast",
    "code-navigation",
    "callers",
    "callees",
    "pagerank",
    "structural-analysis",
    "runtime"
  ],
  "category": "infrastructure",
  "mcpServers": "./.mcp.json",
  "requires": {
    "schema": 1,
    "bin": [
      {
        "name": "bun",
        "check": [
          "bun",
          "--version"
        ],
        "install": [
          {
            "via": "bootstrap",
            "tool": "bun"
          }
        ]
      },
      {
        "name": "mnemex",
        "check": [
          "mnemex",
          "--version"
        ],
        "install": [
          {
            "via": "brew",
            "os": [
              "darwin"
            ],
            "formula": "madappgang/tap/mnemex"
          },
          {
            "via": "release",
            "repo": "MadAppGang/mnemex",
            "tag": "v0.36.2",
            "asset": "mnemex-{os}-{arch}",
            "binary": "mnemex",
            "arch": {
              "amd64": "x64"
            },
            "sha256": {
              "darwin_amd64": "72dba8703bc928ebf00e0f63550c3a183ee2eb6ad8e1b11f53bc1eae56e8000e",
              "darwin_arm64": "d3a1b6bec5034d1d7222955945b62b7d7c50303e3a07918c66099b4b83aa0fd4",
              "linux_amd64": "b2a8ad217a0760a8f90e7c9e140c8e40ae4fa757f058f96e8b7f0d0e02810057",
              "linux_arm64": "e24343f79c3b750d4f57e0779bd9f58e3414dc94f1d4b40b800dc974908ff30c"
            }
          }
        ]
      }
    ]
  }
}
