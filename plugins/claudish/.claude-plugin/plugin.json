{
  "name": "claudish",
  "version": "2.11.0",
  "description": "MCP runtime for external AI models. Proxies OpenRouter, Ollama and LM Studio, runs blind team voting, manages async sessions, and shows the session's runs live above the prompt, with stop and live-screen tabs. Required by code-search, dev, multimodel and designer.",
  "author": {
    "name": "Jack Rudenko",
    "email": "i@madappgang.com",
    "company": "MadAppGang"
  },
  "license": "MIT",
  "keywords": [
    "claudish",
    "mcp",
    "external-models",
    "openrouter",
    "team",
    "voting",
    "multi-model",
    "orchestration",
    "runtime"
  ],
  "category": "infrastructure",
  "skills": "./skills/",
  "mcpServers": "./.mcp.json",
  "types": "./types/index.d.ts",
  "userConfig": {
    "timeline": {
      "type": "string",
      "title": "Run timeline",
      "description": "How the band draws what each model is doing. badges: each finished step as a coloured bar, the current one at the right with its time. line: a running line of steps that pac-man eats.",
      "options": [
        "badges",
        "line"
      ],
      "default": "badges"
    }
  },
  "requires": {
    "schema": 2,
    "bin": [
      {
        "name": "bun",
        "check": [
          "bun",
          "--version"
        ],
        "install": [
          {
            "via": "bootstrap",
            "tool": "bun"
          }
        ]
      },
      {
        "name": "claudish",
        "check": [
          "claudish",
          "--version"
        ],
        "minVersion": "12.3.0",
        "install": [
          {
            "via": "bun",
            "package": "claudish"
          },
          {
            "via": "brew",
            "os": [
              "darwin"
            ],
            "formula": "madappgang/tap/claudish"
          },
          {
            "via": "release",
            "repo": "MadAppGang/claudish",
            "tag": "v12.3.0",
            "asset": "claudish-{os}-{arch}",
            "binary": "claudish",
            "arch": {
              "amd64": "x64"
            },
            "sha256": {
              "darwin_amd64": "a5f1f8705b2ce8bef3cdf32a38464bc94bdfdb673914407e19e35abebe85d9e0",
              "darwin_arm64": "44cd45cc790dac130c9655c58fac2ebf081f21cb9b63ed0b0a927dd94bdfa8bf",
              "linux_amd64": "b740adf6a17211f13ea213047d7fbf773c170dd8491228cac21da0474845fc55",
              "linux_arm64": "320a3a363cb245f1d92592859d3825d04cdbcf34adce41f64c1393207f4a56ba"
            }
          }
        ]
      }
    ]
  }
}
