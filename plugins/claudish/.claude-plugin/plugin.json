{
  "name": "claudish",
  "version": "2.2.0",
  "description": "MCP runtime for external AI models. Proxies OpenRouter, Ollama and LM Studio, runs blind team voting across models, manages async sessions, and streams channel notifications. Required by code-search, dev, multimodel and designer.",
  "author": {
    "name": "Jack Rudenko",
    "email": "i@madappgang.com",
    "company": "MadAppGang"
  },
  "license": "MIT",
  "keywords": [
    "claudish",
    "mcp",
    "external-models",
    "openrouter",
    "team",
    "voting",
    "channels",
    "multi-model",
    "orchestration",
    "runtime"
  ],
  "category": "infrastructure",
  "skills": "./skills/",
  "mcpServers": "./.mcp.json",
  "requires": {
    "schema": 1,
    "bin": [
      {
        "name": "bun",
        "check": [
          "bun",
          "--version"
        ],
        "install": [
          {
            "via": "bootstrap",
            "tool": "bun"
          }
        ]
      },
      {
        "name": "claudish",
        "check": [
          "claudish",
          "--version"
        ],
        "install": [
          {
            "via": "brew",
            "os": [
              "darwin"
            ],
            "formula": "madappgang/tap/claudish"
          },
          {
            "via": "release",
            "repo": "MadAppGang/claudish",
            "tag": "v10.4.1",
            "asset": "claudish-{os}-{arch}",
            "binary": "claudish",
            "arch": {
              "amd64": "x64"
            },
            "sha256": {
              "darwin_amd64": "95a89dbeaae53dee4cbd1ad2166502a0b93d4a5c16b821df4e460abe73027028",
              "darwin_arm64": "439ca8a91bb451c7d07f778895af25d8fabadac1ee76f5fc4a4676d0e3bffcbf",
              "linux_amd64": "d8c3546ece4eda0b8884de01617fcfb67b0a4350c0c4d399a2b06d89951ec394",
              "linux_arm64": "210fdf7fd71b07feeb81d12aa258daba0ac713990ccfe47da69f3504ff79553c"
            }
          }
        ]
      }
    ]
  }
}
