{
  "name": "claudish",
  "version": "2.6.2",
  "description": "MCP runtime for external AI models. Proxies OpenRouter, Ollama and LM Studio, runs blind team voting, manages async sessions, and shows the session's runs live above the prompt, with stop and live-screen tabs. Required by code-search, dev, multimodel and designer.",
  "author": {
    "name": "Jack Rudenko",
    "email": "i@madappgang.com",
    "company": "MadAppGang"
  },
  "license": "MIT",
  "keywords": [
    "claudish",
    "mcp",
    "external-models",
    "openrouter",
    "team",
    "voting",
    "multi-model",
    "orchestration",
    "runtime"
  ],
  "category": "infrastructure",
  "skills": "./skills/",
  "mcpServers": "./.mcp.json",
  "types": "./types/index.d.ts",
  "userConfig": {
    "timeline": {
      "type": "string",
      "title": "Run timeline",
      "description": "How the band draws what each model is doing. badges: each finished step as a timed badge, the current one at the right. line: a running line of steps that pac-man eats.",
      "options": [
        "badges",
        "line"
      ],
      "default": "badges"
    }
  },
  "requires": {
    "schema": 2,
    "bin": [
      {
        "name": "bun",
        "check": [
          "bun",
          "--version"
        ],
        "install": [
          {
            "via": "bootstrap",
            "tool": "bun"
          }
        ]
      },
      {
        "name": "claudish",
        "check": [
          "claudish",
          "--version"
        ],
        "minVersion": "12.1.0",
        "install": [
          {
            "via": "bun",
            "package": "claudish"
          },
          {
            "via": "brew",
            "os": [
              "darwin"
            ],
            "formula": "madappgang/tap/claudish"
          },
          {
            "via": "release",
            "repo": "MadAppGang/claudish",
            "tag": "v12.1.2",
            "asset": "claudish-{os}-{arch}",
            "binary": "claudish",
            "arch": {
              "amd64": "x64"
            },
            "sha256": {
              "darwin_amd64": "9a9e4f02fd868a3e087468942b98e3692435af77c28fb0492eb5a4acddc94c76",
              "darwin_arm64": "b43152e488e965eb5623f473078d7b9f6a2e1a2116085b2cf27430533e97ee80",
              "linux_amd64": "56c3e33a7569f8289d2c71d890134eeabcf2e15c38377cb787b0d351e3c5f5e5",
              "linux_arm64": "3d127c9fa61ce9b43848ef010c4613f34dcc113d66394acc73a5258a8ac35030"
            }
          }
        ]
      }
    ]
  }
}
