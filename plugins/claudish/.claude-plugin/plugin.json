{
  "name": "claudish",
  "version": "2.5.0",
  "description": "MCP runtime for external AI models. Proxies OpenRouter, Ollama and LM Studio, runs blind team voting, manages async sessions, and shows the session's runs live above the prompt, with stop and live-screen tabs. Required by code-search, dev, multimodel and designer.",
  "author": {
    "name": "Jack Rudenko",
    "email": "i@madappgang.com",
    "company": "MadAppGang"
  },
  "license": "MIT",
  "keywords": [
    "claudish",
    "mcp",
    "external-models",
    "openrouter",
    "team",
    "voting",
    "multi-model",
    "orchestration",
    "runtime"
  ],
  "category": "infrastructure",
  "skills": "./skills/",
  "mcpServers": "./.mcp.json",
  "types": "./types/index.d.ts",
  "requires": {
    "schema": 2,
    "bin": [
      {
        "name": "bun",
        "check": [
          "bun",
          "--version"
        ],
        "install": [
          {
            "via": "bootstrap",
            "tool": "bun"
          }
        ]
      },
      {
        "name": "claudish",
        "check": [
          "claudish",
          "--version"
        ],
        "minVersion": "11.1.0",
        "install": [
          {
            "via": "bun",
            "package": "claudish"
          },
          {
            "via": "brew",
            "os": [
              "darwin"
            ],
            "formula": "madappgang/tap/claudish"
          },
          {
            "via": "release",
            "repo": "MadAppGang/claudish",
            "tag": "v11.1.0",
            "asset": "claudish-{os}-{arch}",
            "binary": "claudish",
            "arch": {
              "amd64": "x64"
            },
            "sha256": {
              "darwin_amd64": "7e1482ecb2ab57df13a8355da7ab76ba2b186a7eb93ada991b0189538dee8238",
              "darwin_arm64": "3b17f1ab79dd8277987ddb3712a1ddc0d522b589f0c04c908b9d87e9cdb8df78",
              "linux_amd64": "00e0e62ae89d0d5612b7991e17a51d25db74e4d2219f3f6dc0355de57a7efab9",
              "linux_arm64": "6b814d23f81c7fb01975622fd1694e1938ca8b63c4bc2293f9655a65a84e7cb1"
            }
          }
        ]
      }
    ]
  }
}
