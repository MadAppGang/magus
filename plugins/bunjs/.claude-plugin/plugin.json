{
  "name": "bunjs",
  "version": "0.6.0",
  "description": "Bun and TypeScript toolkit. A `/bunjs:bun` index routes any task to one of eight task-shaped skills (setup, HTTP, errors, testing, security, production, performance, TUI) with copyable code verified against Bun, plus a TypeScript/JavaScript language server that stops when idle. Only Bun is tested.",
  "author": {
    "name": "Jack Rudenko",
    "email": "i@madappgang.com",
    "company": "MadAppGang"
  },
  "license": "MIT",
  "homepage": "https://github.com/MadAppGang/magus",
  "category": "development",
  "keywords": [
    "bun",
    "bunjs",
    "typescript",
    "http",
    "api",
    "error-handling",
    "resilience",
    "testing",
    "security",
    "production",
    "docker",
    "performance",
    "benchmarking",
    "project-structure",
    "tui",
    "opentui",
    "terminal-ui",
    "node-best-practices",
    "router",
    "skill-index",
    "javascript",
    "lsp",
    "language-server"
  ],
  "skills": [
    "./skills/bun",
    "./skills/project-setup",
    "./skills/http-service",
    "./skills/errors",
    "./skills/testing",
    "./skills/security",
    "./skills/production",
    "./skills/performance",
    "./skills/tui"
  ],
  "lspServers": {
    "typescript": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/language-server/bin/launch.sh",
        "typescript-language-server",
        "--stdio"
      ],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".mjs": "javascript",
        ".cjs": "javascript"
      }
    }
  },
  "requires": {
    "schema": 2,
    "bin": [
      {
        "name": "bun",
        "check": [
          "bun",
          "--version"
        ],
        "install": [
          {
            "via": "bootstrap",
            "tool": "bun"
          }
        ]
      }
    ]
  },
  "compatibility": {
    "claudeCode": ">=0.1.0"
  }
}
