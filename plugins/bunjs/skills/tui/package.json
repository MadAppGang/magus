{
  "name": "tui-skill",
  "private": true,
  "description": "Package boundary for the tui skill: one bun install serves assets/ and its tests. Not published.",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "surface": "bun run scripts/check-surface.ts .",
    "surface:self-test": "bun run scripts/check-surface.ts --self-test"
  },
  "dependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/react": "0.4.5",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
